<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="TCP State Machine">
    <mxGraphModel math="1" dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Nodes -->
        <mxCell id="closed" value="CLOSED" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=14;strokeWidth=1.5;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="80" height="80" as="geometry" />
        </mxCell>

        <mxCell id="listen" value="LISTEN" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=14;strokeWidth=1.5;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="560" y="160" width="80" height="80" as="geometry" />
        </mxCell>

        <mxCell id="syn_sent" value="SYN_SENT" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=14;strokeWidth=1.5;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="160" y="160" width="80" height="80" as="geometry" />
        </mxCell>

        <mxCell id="syn_rcvd" value="SYN_RCVD" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=14;strokeWidth=1.5;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="560" y="320" width="80" height="80" as="geometry" />
        </mxCell>

        <mxCell id="established" value="ESTABLISHED" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=14;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="440" width="100" height="100" as="geometry" />
        </mxCell>

        <mxCell id="fin_wait_1" value="FIN_WAIT_1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=14;strokeWidth=1.5;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="160" y="600" width="90" height="90" as="geometry" />
        </mxCell>

        <mxCell id="close_wait" value="CLOSE_WAIT" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=14;strokeWidth=1.5;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="560" y="600" width="90" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fin_wait_2" value="FIN_WAIT_2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=14;strokeWidth=1.5;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="160" y="760" width="90" height="90" as="geometry" />
        </mxCell>

        <mxCell id="last_ack" value="LAST_ACK" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=14;strokeWidth=1.5;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="560" y="760" width="90" height="90" as="geometry" />
        </mxCell>

        <mxCell id="time_wait" value="TIME_WAIT" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=14;strokeWidth=1.5;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="160" y="920" width="90" height="90" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <!-- CLOSED to SYN_SENT (Active Open) -->
        <mxCell id="e_closed_synsent" value="Active Open&#10;Send SYN" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;" edge="1" parent="1" source="closed" target="syn_sent">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="-20" y="-10" /></mxGeometry>
        </mxCell>

        <!-- CLOSED to LISTEN (Passive Open) -->
        <mxCell id="e_closed_listen" value="Passive Open" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;" edge="1" parent="1" source="closed" target="listen">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="20" y="-10" /></mxGeometry>
        </mxCell>

        <!-- LISTEN to SYN_RCVD (Receive SYN) -->
        <mxCell id="e_listen_synrcvd" value="Recv SYN&#10;Send SYN+ACK" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;" edge="1" parent="1" source="listen" target="syn_rcvd">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="40" y="0" /></mxGeometry>
        </mxCell>

        <!-- SYN_SENT to ESTABLISHED (Receive SYN+ACK) -->
        <mxCell id="e_synsent_estab" value="Recv SYN+ACK&#10;Send ACK" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;" edge="1" parent="1" source="syn_sent" target="established">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="-40" y="-10" /></mxGeometry>
        </mxCell>

        <!-- SYN_RCVD to ESTABLISHED (Receive ACK) -->
        <mxCell id="e_synrcvd_estab" value="Recv ACK" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;" edge="1" parent="1" source="syn_rcvd" target="established">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="20" y="-20" /></mxGeometry>
        </mxCell>

        <!-- ESTABLISHED to FIN_WAIT_1 (Active Close) -->
        <mxCell id="e_estab_finwait1" value="Close&#10;Send FIN" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;" edge="1" parent="1" source="established" target="fin_wait_1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="-30" y="-10" /></mxGeometry>
        </mxCell>

        <!-- ESTABLISHED to CLOSE_WAIT (Receive FIN) -->
        <mxCell id="e_estab_closewait" value="Recv FIN&#10;Send ACK" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;" edge="1" parent="1" source="established" target="close_wait">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="30" y="-10" /></mxGeometry>
        </mxCell>

        <!-- FIN_WAIT_1 to FIN_WAIT_2 (Receive ACK) -->
        <mxCell id="e_finwait1_finwait2" value="Recv ACK" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;" edge="1" parent="1" source="fin_wait_1" target="fin_wait_2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="-30" y="0" /></mxGeometry>
        </mxCell>

        <!-- CLOSE_WAIT to LAST_ACK (Close) -->
        <mxCell id="e_closewait_lastack" value="Close&#10;Send FIN" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;" edge="1" parent="1" source="close_wait" target="last_ack">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="30" y="0" /></mxGeometry>
        </mxCell>

        <!-- FIN_WAIT_2 to TIME_WAIT (Receive FIN) -->
        <mxCell id="e_finwait2_timewait" value="Recv FIN&#10;Send ACK" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;" edge="1" parent="1" source="fin_wait_2" target="time_wait">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="-30" y="0" /></mxGeometry>
        </mxCell>

        <!-- TIME_WAIT to CLOSED (Timeout) -->
        <mxCell id="e_timewait_closed" value="Timeout (2MSL)" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="time_wait" target="closed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="80" y="965" />
              <mxPoint x="80" y="80" />
            </Array>
            <mxPoint as="offset" x="0" y="-20" />
          </mxGeometry>
        </mxCell>

        <!-- LAST_ACK to CLOSED (Receive ACK) -->
        <mxCell id="e_lastack_closed" value="Recv ACK" style="endArrow=classic;html=1;curved=1;fontSize=12;labelBackgroundColor=none;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="last_ack" target="closed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="805" />
              <mxPoint x="720" y="80" />
            </Array>
            <mxPoint as="offset" x="0" y="-20" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>