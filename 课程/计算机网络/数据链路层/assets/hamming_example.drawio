        <mxCell id="exp1" value="R1 校验: P1, P3, P5, P7, P9, P11 (\(1 \oplus 1 \oplus 0 \oplus 1 \oplus 0 \oplus 1 = 0\))" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
